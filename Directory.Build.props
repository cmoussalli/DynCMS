<Project>
  <!-- NuGet metadata shared by the packable projects (Core, UI, Host). DynCMS.Web sets IsPackable=false. -->
  <PropertyGroup>
    <Version>0.1.1</Version>
    <Authors>DynCMS</Authors>
    <PackageTags>cms;blazor;aspnetcore;dyncms</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- A component tag Razor cannot resolve (a missing @using) renders as an empty HTML element instead of failing; make it a build error. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
  </PropertyGroup>
</Project>
