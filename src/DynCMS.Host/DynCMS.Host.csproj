<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DynCMS.Host</RootNamespace>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>_content/DynCMS.Host</StaticWebAssetBasePath>
    <Description>DynCMS host: turns an empty ASP.NET Core web project into a running CMS (services, pipeline, Blazor shell, catch-all page and a starter site).</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynCMS.Plugins.Sdk\DynCMS.Plugins.Sdk.csproj" />
    <ProjectReference Include="..\DynCMS.Core\DynCMS.Core.csproj" />
    <ProjectReference Include="..\DynCMS.UI\DynCMS.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DynCMS.Plugins" />
    <Using Include="DynCMS.Plugins.Models" />
    <Using Include="DynCMS.Plugins.Helpers" />
    <Using Include="DynCMS.Plugins.PropertyEditors" />
    <Using Include="DynCMS.Plugins.Templates" />
    <Using Include="DynCMS.Plugins.Components" />
    <Using Include="DynCMS.Plugins.Services" />
  </ItemGroup>

  <!--
    MSBuild defaults for the consuming project (see build/DynCMS.Host.props). The Razor SDK would generate its own
    build/DynCMS.Host.props (just an import of the static web assets props) and overwrite this file, so that generation is
    switched off and build/DynCMS.Host.props imports the static web assets props itself.
  -->
  <PropertyGroup>
    <StaticWebAssetsDisableProjectBuildPropsFileGeneration>true</StaticWebAssetsDisableProjectBuildPropsFileGeneration>
    <StaticWebAssetsDisableProjectBuildMultiTargetingPropsFileGeneration>true</StaticWebAssetsDisableProjectBuildMultiTargetingPropsFileGeneration>
    <StaticWebAssetsDisableProjectBuildTransitivePropsFileGeneration>true</StaticWebAssetsDisableProjectBuildTransitivePropsFileGeneration>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build\DynCMS.Host.props" Pack="true" PackagePath="build\" />
    <None Include="build\DynCMS.Host.Transitive.props" Pack="true" PackagePath="buildTransitive\DynCMS.Host.props" />
  </ItemGroup>

</Project>
