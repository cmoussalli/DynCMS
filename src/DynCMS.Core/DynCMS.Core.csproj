<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DynCMS.Core</RootNamespace>
    <Description>DynCMS core: content model, SQLite/SQL Server persistence, services, registries and security (CMouss.IdentityFramework).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Fluid.Core" Version="2.40.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Users, roles, permissions and tokens for the back office. -->
    <PackageReference Include="CMouss.IdentityFramework" Version="1.5.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DynCMS.Plugins" />
    <Using Include="DynCMS.Plugins.Services" />
    <Using Include="DynCMS.Plugins.Models" />
    <Using Include="DynCMS.Plugins.Helpers" />
    <Using Include="DynCMS.Plugins.PropertyEditors" />
    <Using Include="DynCMS.Plugins.Templates" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynCMS.Plugins.Sdk\DynCMS.Plugins.Sdk.csproj" />
  </ItemGroup>

</Project>
