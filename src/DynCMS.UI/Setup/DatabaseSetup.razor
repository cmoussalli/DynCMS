@page "/setup"
@namespace DynCMS.UI.Setup
@layout BlankLayout
@using DynCMS.Core.Data
@using DynCMS.Core.Services
@using DynCMS.Core.Analytics
@inject IDatabaseSetupService Setup
@inject IDynCmsRuntime Runtime
@inject DynCmsPaths Paths
@inject NavigationManager Nav

<PageTitle>Database setup · DynCMS</PageTitle>

<div class="dc-setup">
    <div class="dc-setup-card">
        <header class="dc-setup-head">
            <span class="dc-brand-mark">D</span>
            <span class="dc-eyebrow">First-run setup</span>
            <h1>Connect DynCMS to a database</h1>
            <p>
                No database configuration was found. Choose where DynCMS should keep its content and users.
                The settings are saved to <code>@Runtime.ConfigurationFilePath</code>.
            </p>
        </header>

        @if (Runtime.IsReady)
        {
            <div class="dc-alert dc-alert-info"><Icon Name="check-circle" Size="16" /> The database is already configured. <a href="@DynCmsUi.AdminBasePath">Open the back office</a></div>
        }
        else
        {
            <section class="dc-setup-section">
                <h4>1. What do you want to do?</h4>
                <div class="dc-setup-options">
                    <button type="button" class="dc-setup-option @(_request.Mode == DatabaseSetupMode.NewDatabase ? "dc-active" : "")" @onclick="() => SetMode(DatabaseSetupMode.NewDatabase)">
                        <Icon Name="sparkles" Size="20" />
                        <strong>Create a new database</strong>
                        <span>Start empty. DynCMS creates the database and its schema for you.</span>
                        @if (_request.Mode == DatabaseSetupMode.NewDatabase) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                    </button>
                    <button type="button" class="dc-setup-option @(_request.Mode == DatabaseSetupMode.ExistingDatabase ? "dc-active" : "")" @onclick="() => SetMode(DatabaseSetupMode.ExistingDatabase)">
                        <Icon Name="layers" Size="20" />
                        <strong>Use an existing database</strong>
                        <span>Connect to a database that already exists. DynCMS tables are added if they are missing.</span>
                        @if (_request.Mode == DatabaseSetupMode.ExistingDatabase) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                    </button>
                </div>
            </section>

            <section class="dc-setup-section">
                <h4>2. Database engine</h4>
                <div class="dc-setup-options">
                    <button type="button" class="dc-setup-option @(_request.Provider == DatabaseProvider.Sqlite ? "dc-active" : "")" @onclick="() => SetProvider(DatabaseProvider.Sqlite)">
                        <Icon Name="file" Size="20" />
                        <strong>SQLite</strong>
                        <span>A single file inside the application folder. No server needed; ideal for small sites and development.</span>
                        @if (_request.Provider == DatabaseProvider.Sqlite) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                    </button>
                    <button type="button" class="dc-setup-option @(_request.Provider == DatabaseProvider.SqlServer ? "dc-active" : "")" @onclick="() => SetProvider(DatabaseProvider.SqlServer)">
                        <Icon Name="box" Size="20" />
                        <strong>SQL Server</strong>
                        <span>Microsoft SQL Server or Azure SQL, using SQL authentication.</span>
                        @if (_request.Provider == DatabaseProvider.SqlServer) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                    </button>
                </div>
            </section>

            <section class="dc-setup-section">
                <h4>3. Connection details</h4>

                @if (_request.Provider == DatabaseProvider.Sqlite)
                {
                    <label class="dc-field">
                        <span class="dc-label">Database file</span>
                        <input class="dc-input" type="text" @bind="_request.SqlitePath" @bind:after="ClearResult" placeholder="App_Data/dyncms.db" disabled="@_busy" />
                        <small class="dc-setup-path">@ResolvedSqlitePath</small>
                        <small class="dc-muted">
                            @(_request.Mode == DatabaseSetupMode.NewDatabase
                                ? "Relative paths are inside the application root. The file must not exist yet."
                                : "Relative paths are inside the application root. Point this at the existing .db file.")
                        </small>
                    </label>
                }
                else
                {
                    <div class="dc-form-grid">
                        <label class="dc-field">
                            <span class="dc-label">Server</span>
                            <input class="dc-input" type="text" @bind="_request.Server" @bind:after="ClearResult" placeholder="localhost or server\instance" disabled="@_busy" />
                        </label>
                        <label class="dc-field">
                            <span class="dc-label">Port</span>
                            <input class="dc-input" type="number" min="1" max="65535" @bind="_request.Port" @bind:after="ClearResult" disabled="@_busy" />
                        </label>
                        <div class="dc-field">
                            <label class="dc-label" for="dc-setup-database">Database name</label>
                            <input id="dc-setup-database" class="dc-input" type="text" @bind="_request.Database" @bind:after="ClearResult" placeholder="DynCMS" disabled="@_busy" />
                            @if (_request.Mode == DatabaseSetupMode.NewDatabase)
                            {
                                <label class="dc-check">
                                    <input type="checkbox" @bind="_request.CreateDatabase" @bind:after="ClearResult" disabled="@_busy" />
                                    <span>Create the database if it does not exist (uses the master database)</span>
                                </label>
                            }
                        </div>
                        <div class="dc-field">
                            <span class="dc-label">Trust server certificate</span>
                            <label class="dc-toggle dc-setup-toggle">
                                <input type="checkbox" @bind="_request.TrustServerCertificate" @bind:after="ClearResult" disabled="@_busy" />
                                <span class="dc-toggle-track"><span class="dc-toggle-thumb"></span></span>
                                <span>@(_request.TrustServerCertificate ? "Accept self-signed certificates" : "Require a trusted certificate")</span>
                            </label>
                        </div>
                        <label class="dc-field">
                            <span class="dc-label">User</span>
                            <input class="dc-input" type="text" @bind="_request.UserName" @bind:after="ClearResult" autocomplete="off" placeholder="sa" disabled="@_busy" />
                        </label>
                        <label class="dc-field">
                            <span class="dc-label">Password</span>
                            <input class="dc-input" type="password" @bind="_request.Password" @bind:after="ClearResult" autocomplete="new-password" disabled="@_busy" />
                        </label>
                    </div>
                }
            </section>

            <section class="dc-setup-section">
                <h4>4. Starting content</h4>
                <div class="dc-setup-options">
                    <button type="button" class="dc-setup-option @(_request.StarterContent == StarterContent.EmptySite ? "dc-active" : "")" @onclick="() => SetStarterContent(StarterContent.EmptySite)">
                        <Icon Name="file" Size="20" />
                        <strong>Empty website</strong>
                        <span>Only the home page exists. You build the rest yourself in the back office.</span>
                        @if (_request.StarterContent == StarterContent.EmptySite) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                    </button>
                    <button type="button" class="dc-setup-option @(_request.StarterContent == StarterContent.DemoBlog ? "dc-active" : "")" @onclick="() => SetStarterContent(StarterContent.DemoBlog)">
                        <Icon Name="newspaper" Size="20" />
                        <strong>Demo blog</strong>
                        <span>A small blog that shows what the system does: articles on several pages, categories, tags, images and a draft to preview.</span>
                        @if (_request.StarterContent == StarterContent.DemoBlog) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                    </button>
                </div>
                <small class="dc-muted">Applies only when the database has no content yet. Everything created is ordinary content you can edit or delete later.</small>
            </section>

            <section class="dc-setup-section">
                <h4>5. Visitor analytics</h4>
                <div class="dc-setup-options">
                    <button type="button" class="dc-setup-option @(!_separateAnalytics ? "dc-active" : "")" @onclick="() => SetSeparateAnalytics(false)">
                        <Icon Name="database" Size="20" />
                        <strong>Same database</strong>
                        <span>Page views are stored next to the content. One database, one backup. Can be changed later under Data.</span>
                        @if (!_separateAnalytics) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                    </button>
                    <button type="button" class="dc-setup-option @(_separateAnalytics ? "dc-active" : "")" @onclick="() => SetSeparateAnalytics(true)">
                        <Icon Name="bar-chart" Size="20" />
                        <strong>Separate database</strong>
                        <span>Keeps the page view history out of content backups and restores, with its own backups. Either engine.</span>
                        @if (_separateAnalytics) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                    </button>
                </div>
                @if (_separateAnalytics)
                {
                    <div style="margin-top:12px">
                        <DynCMS.UI.Admin.Components.DatabaseConnectionFields Request="_analytics" Busy="_busy" IdPrefix="dc-setup-analytics" OnChanged="ClearResult" />
                    </div>
                    @if (_existingHistory is { } history)
                    {
                        <div class="dc-alert dc-alert-warn" style="margin-top:14px">
                            <Icon Name="alert" Size="15" />
                            <span>The existing database already holds <strong>@history.PageViews.ToString("N0") page views</strong> recorded before it had a separate analytics database. Choose what happens to them:</span>
                        </div>
                        <div class="dc-setup-options">
                            <button type="button" class="dc-setup-option @(_history == AnalyticsHistoryAction.Move ? "dc-active" : "")" @onclick="() => SetHistory(AnalyticsHistoryAction.Move)">
                                <Icon Name="arrow-right" Size="20" />
                                <strong>Move them to the analytics database</strong>
                                <span>The history is copied across and the analytics tables are dropped from the content database. The reports continue unchanged.</span>
                                @if (_history == AnalyticsHistoryAction.Move) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                            </button>
                            <button type="button" class="dc-setup-option @(_history == AnalyticsHistoryAction.Delete ? "dc-active" : "")" @onclick="() => SetHistory(AnalyticsHistoryAction.Delete)">
                                <Icon Name="trash" Size="20" />
                                <strong>Delete them and start over</strong>
                                <span>The old page views are removed for good, which keeps the content database small.</span>
                                @if (_history == AnalyticsHistoryAction.Delete) { <Icon Name="check-circle" Size="16" Class="dc-setup-check" /> }
                            </button>
                        </div>
                    }
                }
            </section>

            <section class="dc-setup-section">
                <h4>6. Administrator account</h4>
                <div class="dc-form-grid">
                    <label class="dc-field">
                        <span class="dc-label">User name</span>
                        <input class="dc-input" type="text" @bind="_request.AdminUserName" @bind:after="ClearResult" autocomplete="username" disabled="@_busy" />
                    </label>
                    <span></span>
                    <label class="dc-field">
                        <span class="dc-label">Password</span>
                        <input class="dc-input" type="password" @bind="_request.AdminPassword" @bind:after="ClearResult" autocomplete="new-password" disabled="@_busy" />
                    </label>
                    <label class="dc-field">
                        <span class="dc-label">Confirm password</span>
                        <input class="dc-input" type="password" @bind="_request.AdminPasswordConfirm" @bind:after="ClearResult" autocomplete="new-password" disabled="@_busy" />
                    </label>
                </div>
                <small class="dc-muted">You sign in to the back office with this account. At least 8 characters. Ignored when the existing database already has an administrator.</small>
            </section>

            @if (_result is not null)
            {
                <div class="dc-setup-result @(_result.Success ? "dc-setup-result-ok" : "dc-setup-result-error")" role="status">
                    <strong><Icon Name="@(_result.Success ? "check-circle" : "alert")" Size="16" /> @_result.Message</strong>
                    @if (_result.Details.Count > 0)
                    {
                        <ul>
                            @foreach (var line in _result.Details) { <li>@line</li> }
                        </ul>
                    }
                </div>
            }

            <footer class="dc-setup-actions">
                <button type="button" class="dc-btn" @onclick="TestAsync" disabled="@_busy">
                    @if (_busy && _action == "test") { <span class="dc-spinner"></span> } else { <Icon Name="zap" Size="15" /> }
                    <span>Test connection</span>
                </button>
                <button type="button" class="dc-btn dc-btn-primary" @onclick="FinishAsync" disabled="@_busy">
                    @if (_busy && _action == "finish")
                    {
                        <span class="dc-spinner" style="border-color: rgba(255,255,255,.35); border-top-color: #fff; width: 16px; height: 16px;"></span>
                        <span>Setting up…</span>
                    }
                    else
                    {
                        <span>Finish setup</span>
                        <Icon Name="arrow-right" Size="15" />
                    }
                </button>
            </footer>
        }
    </div>
</div>

@code {
    private readonly DatabaseSetupRequest _request = new();
    private readonly DatabaseSetupRequest _analytics = new() { SqlitePath = Path.Combine("App_Data", "dyncms-analytics.db"), Database = "DynCMS_Analytics" };
    private bool _separateAnalytics;
    private AnalyticsHistoryInfo? _existingHistory;
    private AnalyticsHistoryAction _history = AnalyticsHistoryAction.Move;
    private DatabaseTestResult? _result;
    private bool _busy;
    private string? _action;

    private string ResolvedSqlitePath
    {
        get
        {
            try { return Path.GetFullPath(Path.Combine(Paths.BasePath, _request.SqlitePath.Trim())); }
            catch { return string.Empty; }
        }
    }

    private void SetMode(DatabaseSetupMode mode)
    {
        _request.Mode = mode;
        ClearResult();
    }

    private void SetProvider(DatabaseProvider provider)
    {
        _request.Provider = provider;
        ClearResult();
    }

    private void SetStarterContent(StarterContent starter)
    {
        _request.StarterContent = starter;
        ClearResult();
    }

    private void SetHistory(AnalyticsHistoryAction action)
    {
        _history = action;
        ClearResult();
    }

    /// <summary>With a separate analytics database and an existing content database, find out whether it already holds page views.</summary>
    private async Task RefreshExistingHistoryAsync()
    {
        _existingHistory = null;
        if (!_separateAnalytics || _request.Mode != DatabaseSetupMode.ExistingDatabase) return;
        var history = await Setup.CountExistingAnalyticsAsync(_request);
        _existingHistory = history is { IsEmpty: false } ? history : null;
    }

    private async Task SetSeparateAnalytics(bool separate)
    {
        _separateAnalytics = separate;
        if (separate)
        {
            // Start from the primary settings so a SQL Server user only has to change the database name.
            _analytics.Provider = _request.Provider;
            _analytics.Server = _request.Server;
            _analytics.Port = _request.Port;
            _analytics.UserName = _request.UserName;
            _analytics.Password = _request.Password;
            _analytics.TrustServerCertificate = _request.TrustServerCertificate;
        }
        ClearResult();
        await RefreshExistingHistoryAsync();
    }

    private void ClearResult() => _result = null;

    private async Task TestAsync()
    {
        if (_busy) return;
        _busy = true;
        _action = "test";
        try
        {
            _result = await Setup.TestConnectionAsync(_request);
            await RefreshExistingHistoryAsync();
            if (_result.Success && _separateAnalytics)
            {
                var analytics = await Setup.TestConnectionAsync(_analytics, DatabaseRole.Analytics);
                _result = analytics.Success
                    ? new DatabaseTestResult(true, _result.Message + " Analytics: " + analytics.Message, [.. _result.Details, .. analytics.Details])
                    : analytics with { Message = "Analytics database: " + analytics.Message };
            }
        }
        finally
        {
            _busy = false;
            _action = null;
        }
    }

    private async Task FinishAsync()
    {
        if (_busy) return;
        _busy = true;
        _action = "finish";
        try
        {
            _result = await Setup.CompleteSetupAsync(_request, _separateAnalytics ? _analytics : null, _history);
            if (_result.Success)
                Nav.NavigateTo(DynCmsUi.LoginPath, forceLoad: true);
        }
        finally
        {
            _busy = false;
            _action = null;
        }
    }
}
