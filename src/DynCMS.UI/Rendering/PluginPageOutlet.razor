@namespace DynCMS.UI.Rendering
@using DynCMS.Core.Plugins
@implements IDisposable
@inject IPluginRouter Router
@inject ILanguageService Languages

@*
    Mounts the page of a running plugin for a request path. The host pages (the back office's /admin/{**rest} and the
    site's catch-all) render this with the path; when no plugin page matches, the child content renders instead
    (the site's content renderer, or a "not found" panel).

    PluginComponentView creates the plugin component: directly in the interactive circuit, and as prerendered HTML
    (through the plugin-aware service provider) before that, so plugin pages are part of the server-rendered page.
*@

@if (_match is null)
{
    @ChildContent
}
else
{
    <PluginComponentView ComponentType="_match.Page.ComponentType" Layout="_match.Page.Layout" Parameters="_parameters" ForwardHead="true" @key="_match.Page.ComponentType" />
}

@code {
    /// <summary>Absolute request path without query string, e.g. <c>/admin/shop/orders/3</c>.</summary>
    [Parameter, EditorRequired] public string Path { get; set; } = "/";

    /// <summary>Match back-office pages (<c>/admin/…</c>) or site pages.</summary>
    [Parameter] public bool Admin { get; set; }

    /// <summary>What to render when no plugin page matches the path.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>True when a plugin page matched the current path.</summary>
    public bool Matched => _match is not null;

    private PluginPageMatch? _match;
    private Dictionary<string, object?> _parameters = [];

    protected override void OnInitialized() => Router.Changed += OnRoutesChanged;

    protected override Task OnParametersSetAsync() => ResolveAsync();

    private async Task ResolveAsync()
    {
        var path = Path.Split('?')[0];
        _match = Router.Match(path, Admin);

        // A site page also answers under a language prefix: /de/guestbook reaches the plugin page /guestbook. The
        // plugin reads the language from ICultureContext (it derives it from the same prefix).
        if (_match is null && !Admin)
        {
            var trimmed = path.Trim('/');
            var slash = trimmed.IndexOf('/');
            var first = slash < 0 ? trimmed : trimmed[..slash];
            if (first.Length > 0)
            {
                try
                {
                    if ((await Languages.GetAllAsync()).Match(first) is not null)
                        _match = Router.Match(slash < 0 ? "/" : "/" + trimmed[(slash + 1)..], Admin);
                }
                catch (InvalidOperationException)
                {
                    // the database is not ready; there are no languages to match
                }
            }
        }

        _parameters = _match?.ComponentParameters() ?? [];
    }

    private void OnRoutesChanged() => _ = InvokeAsync(async () =>
    {
        await ResolveAsync();
        StateHasChanged();
    });

    public void Dispose() => Router.Changed -= OnRoutesChanged;
}
