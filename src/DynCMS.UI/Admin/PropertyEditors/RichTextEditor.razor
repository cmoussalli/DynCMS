@namespace DynCMS.UI.Admin.PropertyEditors
@inherits PropertyEditorBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IMediaService Media

<div class="dc-rte @(Invalid ? "dc-invalid" : null)">
    <div class="dc-rte-toolbar" @onmousedown:preventDefault="true">
        <button type="button" title="Paragraph" @onclick='() => ExecAsync("formatBlock", "p")'><Icon Name="paragraph" Size="15" /></button>
        <button type="button" title="Heading 2" @onclick='() => ExecAsync("formatBlock", "h2")'><Icon Name="h2" Size="15" /></button>
        <button type="button" title="Heading 3" @onclick='() => ExecAsync("formatBlock", "h3")'><Icon Name="h3" Size="15" /></button>
        <span class="dc-rte-sep"></span>
        <button type="button" title="Bold" @onclick='() => ExecAsync("bold")'><Icon Name="bold" Size="15" /></button>
        <button type="button" title="Italic" @onclick='() => ExecAsync("italic")'><Icon Name="italic" Size="15" /></button>
        <button type="button" title="Underline" @onclick='() => ExecAsync("underline")'><Icon Name="underline" Size="15" /></button>
        <span class="dc-rte-sep"></span>
        <button type="button" title="Bullet list" @onclick='() => ExecAsync("insertUnorderedList")'><Icon Name="list" Size="15" /></button>
        <button type="button" title="Numbered list" @onclick='() => ExecAsync("insertOrderedList")'><Icon Name="ol" Size="15" /></button>
        <button type="button" title="Quote" @onclick='() => ExecAsync("formatBlock", "blockquote")'><Icon Name="message" Size="15" /></button>
        <button type="button" title="Code" @onclick='() => ExecAsync("formatBlock", "pre")'><Icon Name="code" Size="15" /></button>
        <span class="dc-rte-sep"></span>
        <button type="button" title="Link" @onclick="OpenLinkAsync"><Icon Name="link" Size="15" /></button>
        <button type="button" title="Remove link" @onclick='() => ExecAsync("unlink")'><Icon Name="unlink" Size="15" /></button>
        <button type="button" title="Insert image" @onclick="OpenImageAsync"><Icon Name="image" Size="15" /></button>
        <span class="dc-rte-sep"></span>
        <button type="button" title="Clear formatting" @onclick='() => ExecAsync("removeFormat")'><Icon Name="eraser" Size="15" /></button>
        <button type="button" class="@(_showSource ? "dc-active" : null)" title="HTML source" @onclick="ToggleSourceAsync"><Icon Name="code" Size="15" /> HTML</button>
    </div>

    @if (_linkOpen)
    {
        <div class="dc-rte-popover">
            <input class="dc-input" type="url" placeholder="https://…" @bind="_linkUrl" @bind:event="oninput" />
            <button type="button" class="dc-btn dc-btn-primary dc-btn-sm" @onclick="ApplyLinkAsync" disabled="@string.IsNullOrWhiteSpace(_linkUrl)">Apply</button>
            <button type="button" class="dc-btn dc-btn-sm" @onclick="() => _linkOpen = false">Cancel</button>
        </div>
    }

    <div class="dc-rte-body" contenteditable="true" @ref="_editor" style="@(_showSource ? "display:none" : null)"></div>

    @if (_showSource)
    {
        <textarea class="dc-input dc-rte-source" rows="12" value="@Value" @onchange="OnSourceChangedAsync"></textarea>
    }
</div>

@if (_imageOpen)
{
    <Modal Title="Insert image" Size="Modal.ModalSize.Large" OnClose="() => _imageOpen = false">
        <MediaBrowser PickMode="true" ImagesOnly="true" OnPick="InsertImageAsync" />
    </Modal>
}

@code {
    private ElementReference _editor;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RichTextEditor>? _self;
    private string? _lastHtml;
    private bool _initialized;
    private bool _showSource;
    private bool _linkOpen;
    private bool _imageOpen;
    private string? _linkUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DynCMS.UI/dyncms-admin.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("rte.init", _editor, _self);
            _initialized = true;
            _lastHtml = Value;
            await _module.InvokeVoidAsync("rte.setHtml", _editor, Value ?? string.Empty);
        }
        else if (_initialized && !_showSource && !string.Equals(_lastHtml, Value, StringComparison.Ordinal))
        {
            // Value changed from the outside (for example after a reload) — sync the editor.
            _lastHtml = Value;
            await _module!.InvokeVoidAsync("rte.setHtml", _editor, Value ?? string.Empty);
        }
    }

    [JSInvokable]
    public Task OnHtmlChanged(string html)
    {
        var normalized = string.IsNullOrWhiteSpace(html) || html is "<br>" or "<div><br></div>" ? null : html;
        _lastHtml = normalized;
        return SetValueAsync(normalized);
    }

    private async Task ExecAsync(string command, string? value = null)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("rte.exec", _editor, command, value);
    }

    private async Task OpenLinkAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("rte.saveSelection");
        _linkUrl = null;
        _linkOpen = true;
    }

    private async Task ApplyLinkAsync()
    {
        if (_module is null || string.IsNullOrWhiteSpace(_linkUrl)) return;
        await _module.InvokeVoidAsync("rte.execWithSelection", _editor, "createLink", _linkUrl.Trim());
        _linkOpen = false;
    }

    private async Task OpenImageAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("rte.saveSelection");
        _imageOpen = true;
    }

    private async Task InsertImageAsync(MediaItem item)
    {
        _imageOpen = false;
        if (_module is null) return;
        var url = Media.GetUrl(item);
        var html = $"<img src=\"{url}\" alt=\"{System.Net.WebUtility.HtmlEncode(item.Name)}\" />";
        await _module.InvokeVoidAsync("rte.execWithSelection", _editor, "insertHTML", html);
    }

    private async Task ToggleSourceAsync()
    {
        _showSource = !_showSource;
        if (!_showSource && _module is not null)
        {
            _lastHtml = Value;
            await _module.InvokeVoidAsync("rte.setHtml", _editor, Value ?? string.Empty);
        }
    }

    private async Task OnSourceChangedAsync(ChangeEventArgs e)
    {
        var html = e.Value?.ToString();
        _lastHtml = string.IsNullOrWhiteSpace(html) ? null : html;
        await SetValueAsync(_lastHtml);
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
