@namespace DynCMS.UI.Admin.PropertyEditors
@inherits PropertyEditorBase

<div class="dc-inline">
    <input id="@InputId" class="@InputClass dc-input-narrow" type="@(IncludeTime ? "datetime-local" : "date")"
           value="@Display" @onchange="e => SetValueAsync(Normalize(e.Value?.ToString()))" />
    @if (!string.IsNullOrEmpty(Value))
    {
        <button type="button" class="dc-btn dc-btn-ghost" title="Clear" @onclick="() => SetValueAsync(null)"><Icon Name="x" Size="14" /></button>
    }
</div>

@code {
    private bool IncludeTime => ConfigBool("includeTime");

    private string? Display
    {
        get
        {
            var d = ContentValueConverter.Convert<DateTime?>(Value);
            if (d is null) return null;
            return IncludeTime ? d.Value.ToString("yyyy-MM-dd'T'HH:mm", CultureInfo.InvariantCulture)
                               : d.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
    }

    private string? Normalize(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        return DateTime.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            ? (IncludeTime ? d.ToString("yyyy-MM-dd'T'HH:mm", CultureInfo.InvariantCulture) : d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))
            : raw;
    }
}
