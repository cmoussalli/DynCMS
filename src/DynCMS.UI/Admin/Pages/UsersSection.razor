@page "/admin/users"
@namespace DynCMS.UI.Admin.Pages
@attribute [Authorize(Roles = CmsRoles.Admin)]
@using CMouss.IdentityFramework.BlazorUI.Admin

<PageTitle>Users &amp; security · DynCMS</PageTitle>

@* The identity management screens are Bootstrap based; the stylesheet is only loaded on this page. *@
<HeadContent>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</HeadContent>

<div class="dc-page dc-page-wide">
    <header class="dc-page-head">
        <h1><Icon Name="shield" Size="22" /> Users &amp; security</h1>
        <p class="dc-muted">
            Users, roles, entity/action permissions and sign-in tokens are managed by
            <strong>CMouss.IdentityFramework</strong>. Back-office access uses the roles
            <code>@CmsRoles.Admin</code> (full access) and <code>@CmsRoles.Editor</code> (content and media).
        </p>
    </header>

    <div class="dc-card dc-idf">
        <IdentityAdminPart DefaultTab="users" />
    </div>
</div>
