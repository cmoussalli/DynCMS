@page "/admin/data"
@page "/admin/data/{View}"
@namespace DynCMS.UI.Admin.Pages
@attribute [Authorize(Roles = CmsRoles.Admin)]
@inject NavigationManager Nav

@code {
    // The Data section now lives under System; keep old links and bookmarks working.
    [Parameter] public string? View { get; set; }

    protected override void OnInitialized() =>
        Nav.NavigateTo(string.IsNullOrEmpty(View) ? "/admin/system/database" : $"/admin/system/{Uri.EscapeDataString(View)}", replace: true);
}
