@page "/admin/files"
@namespace DynCMS.UI.Admin.Pages
@attribute [Authorize(Roles = CmsRoles.Admin)]
@implements IAsyncDisposable
@using Microsoft.Extensions.Options
@inject IWebRootFileService Files
@inject ToastService Toasts
@inject IOptions<DynCmsOptions> Options
@inject IJSRuntime JS

<PageTitle>Files · DynCMS</PageTitle>

<div class="dc-page dc-page-wide">
    <header class="dc-page-head dc-page-head-row">
        <div>
            <h1><Icon Name="folder" Size="22" /> Files</h1>
            <p class="dc-muted">The files in the site's <code>wwwroot</code> folder (stylesheets, scripts, images, fonts). Download folders as ZIP, upload a ZIP to extract it, and edit text files in place.</p>
        </div>
    </header>

    @if (_editing is not null)
    {
        <div class="dc-card dc-card-flush">
            <div class="dc-files-toolbar">
                <nav class="dc-crumbs">
                    <button type="button" @onclick="CloseEditorAsync"><Icon Name="chevron-left" Size="14" /> Back</button>
                    <span>/</span>
                    <strong>@_editing</strong>
                    @if (Dirty) { <span class="dc-badge dc-badge-warn">Unsaved changes</span> }
                </nav>
                <div class="dc-media-actions">
                    <a class="dc-btn dc-btn-sm" href="@DownloadUrl(_editing)" download><Icon Name="download" Size="14" /> Download</a>
                    <button type="button" class="dc-btn dc-btn-primary dc-btn-sm" disabled="@(!Dirty || _saving)" @onclick="SaveAsync"><Icon Name="save" Size="14" /> Save</button>
                </div>
            </div>
            <textarea class="dc-code-input" @ref="_editor" spellcheck="false" autocomplete="off" autocapitalize="off"
                      @bind="_text" @bind:event="oninput"></textarea>
            <div class="dc-files-status">
                <span>@_text.Split('\n').Length lines · @_text.Length chars</span>
                <span class="dc-muted">Tab indents · Ctrl+S saves</span>
            </div>
        </div>
    }
    else
    {
        <div class="dc-card dc-card-flush">
            <div class="dc-files-toolbar">
                <nav class="dc-crumbs">
                    <button type="button" @onclick='() => GoAsync("")'><Icon Name="folder" Size="14" /> wwwroot</button>
                    @foreach (var crumb in Crumbs)
                    {
                        <span>/</span>
                        @if (crumb.Path == _folder) { <strong>@crumb.Name</strong> }
                        else { <button type="button" @onclick="() => GoAsync(crumb.Path)">@crumb.Name</button> }
                    }
                </nav>
                <div class="dc-media-actions">
                    <button type="button" class="dc-btn dc-btn-sm" @onclick="() => StartCreate(true)"><Icon Name="folder-plus" Size="14" /> New folder</button>
                    <button type="button" class="dc-btn dc-btn-sm" @onclick="() => StartCreate(false)"><Icon Name="file" Size="14" /> New file</button>
                    <label class="dc-btn dc-btn-sm dc-upload" title="Upload a ZIP archive and extract it into this folder">
                        <Icon Name="upload" Size="14" /> Upload ZIP
                        <InputFile OnChange="UploadZipAsync" accept=".zip,application/zip,application/x-zip-compressed" />
                    </label>
                    <label class="dc-btn dc-btn-primary dc-btn-sm dc-upload">
                        <Icon Name="upload" Size="14" /> Upload files
                        <InputFile OnChange="UploadAsync" multiple />
                    </label>
                    <a class="dc-btn dc-btn-sm" href="@DownloadUrl(_folder)" download title="Download this folder as a ZIP archive"><Icon Name="download" Size="14" /> Download folder</a>
                </div>
            </div>

            @if (_creating is not null)
            {
                <div class="dc-inline dc-media-newfolder">
                    <input class="dc-input dc-input-narrow" type="text" placeholder="@(_creating == true ? "Folder name" : "File name, e.g. site.css")"
                           @bind="_newName" @bind:event="oninput" @onkeyup="OnCreateKeyUp" />
                    <button type="button" class="dc-btn dc-btn-primary dc-btn-sm" disabled="@string.IsNullOrWhiteSpace(_newName)" @onclick="CreateAsync">Create</button>
                    <button type="button" class="dc-btn dc-btn-sm" @onclick="() => _creating = null">Cancel</button>
                </div>
            }

            @if (_busy is not null)
            {
                <div class="dc-alert dc-alert-info"><span class="dc-spinner"></span> @_busy</div>
            }
            @if (_error is not null)
            {
                <div class="dc-alert dc-alert-error"><Icon Name="alert" Size="15" /> <span>@_error</span></div>
            }

            <div class="dc-table-wrap dc-files-table">
                <table class="dc-table">
                    <thead>
                        <tr><th>Name</th><th>Size</th><th>Modified</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (_folder.Length > 0)
                        {
                            <tr class="dc-files-up" @onclick="() => GoAsync(ParentOf(_folder))">
                                <td colspan="4"><Icon Name="chevron-left" Size="15" /> <span>..</span></td>
                            </tr>
                        }
                        @foreach (var e in _entries)
                        {
                            <tr @key="e.Path">
                                <td>
                                    @if (_renaming == e.Path)
                                    {
                                        <input class="dc-input dc-input-narrow" type="text" @bind="_renameTo" @bind:event="oninput" @onkeyup="OnRenameKeyUp" />
                                        <button type="button" class="dc-btn dc-btn-primary dc-btn-sm" @onclick="RenameAsync">Rename</button>
                                        <button type="button" class="dc-btn dc-btn-sm" @onclick="() => _renaming = null">Cancel</button>
                                    }
                                    else if (e.IsFolder)
                                    {
                                        <button type="button" class="dc-files-name" @onclick="() => GoAsync(e.Path)"><Icon Name="folder" Size="16" /> <span>@e.Name</span></button>
                                    }
                                    else if (Files.IsEditable(e.Name))
                                    {
                                        <button type="button" class="dc-files-name" @onclick="() => OpenAsync(e)" title="Edit"><Icon Name="file" Size="16" /> <span>@e.Name</span></button>
                                    }
                                    else
                                    {
                                        <span class="dc-files-name dc-files-plain"><Icon Name="file" Size="16" /> <span>@e.Name</span></span>
                                    }
                                </td>
                                <td class="dc-muted">@(e.IsFolder ? "—" : MediaPickerEditor.FormatSize(e.SizeBytes))</td>
                                <td class="dc-muted">@e.ModifiedUtc.ToLocalTime().ToString("g")</td>
                                <td class="dc-table-actions">
                                    @if (!e.IsFolder && Files.IsEditable(e.Name))
                                    {
                                        <button type="button" class="dc-btn dc-btn-icon" title="Edit" @onclick="() => OpenAsync(e)"><Icon Name="edit" Size="15" /></button>
                                    }
                                    @if (!e.IsFolder)
                                    {
                                        <a class="dc-btn dc-btn-icon" title="Open in a new tab" href="/@e.Path" target="_blank" rel="noopener"><Icon Name="external" Size="15" /></a>
                                    }
                                    <a class="dc-btn dc-btn-icon" title="@(e.IsFolder ? "Download as ZIP" : "Download")" href="@DownloadUrl(e.Path)" download><Icon Name="download" Size="15" /></a>
                                    <button type="button" class="dc-btn dc-btn-icon" title="Rename" @onclick="() => StartRename(e)"><Icon Name="edit" Size="15" /></button>
                                    <button type="button" class="dc-btn dc-btn-icon" title="Delete" @onclick="() => _deleting = e"><Icon Name="trash" Size="15" /></button>
                                </td>
                            </tr>
                        }
                        @if (_entries.Count == 0)
                        {
                            <tr><td colspan="4"><div class="dc-empty"><Icon Name="folder" Size="28" /><p>This folder is empty.</p><span class="dc-muted">Upload files or a ZIP archive using the buttons above.</span></div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (_deleting is not null)
{
    <ConfirmDialog Title="@($"Delete {(_deleting.IsFolder ? "folder" : "file")}")"
                   Message="@($"Delete \"{_deleting.Name}\"{(_deleting.IsFolder ? " and everything in it" : "")}? This cannot be undone.")"
                   ConfirmText="Delete" Danger="true" OnConfirm="DeleteAsync" OnCancel="() => _deleting = null" />
}

@code {
    private string _folder = string.Empty;
    private IReadOnlyList<WebRootEntry> _entries = [];
    private string? _error;
    private string? _busy;

    private bool? _creating;          // true = folder, false = file
    private string? _newName;
    private string? _renaming;
    private string? _renameTo;
    private WebRootEntry? _deleting;

    private string? _editing;
    private string _text = string.Empty;
    private string _saved = string.Empty;
    private bool _saving;
    private ElementReference _editor;
    private bool _editorWired;
    private IJSObjectReference? _module;
    private DotNetObjectReference<FilesSection>? _self;

    private bool Dirty => _editing is not null && !string.Equals(_text, _saved, StringComparison.Ordinal);

    private IEnumerable<(string Name, string Path)> Crumbs
    {
        get
        {
            var acc = string.Empty;
            foreach (var part in _folder.Split('/', StringSplitOptions.RemoveEmptyEntries))
            {
                acc = acc.Length == 0 ? part : acc + "/" + part;
                yield return (part, acc);
            }
        }
    }

    private static string DownloadUrl(string path) => $"{DynCmsUi.AdminBasePath.TrimEnd('/')}/files/download?path={Uri.EscapeDataString(path)}";
    private static string ParentOf(string path) => path.Contains('/') ? path[..path.LastIndexOf('/')] : string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task LoadAsync()
    {
        try
        {
            _entries = Files.List(_folder);
            _error = null;
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException)
        {
            _entries = [];
            _error = ex.Message;
        }
        return Task.CompletedTask;
    }

    private async Task GoAsync(string folder)
    {
        _folder = folder;
        _creating = null;
        _renaming = null;
        await LoadAsync();
    }

    // ---- create / rename / delete ----------------------------------------------------------------

    private void StartCreate(bool folder)
    {
        _creating = folder;
        _newName = null;
    }

    private Task OnCreateKeyUp(KeyboardEventArgs e) => e.Key == "Enter" ? CreateAsync() : Task.CompletedTask;

    private async Task CreateAsync()
    {
        if (_creating is null || string.IsNullOrWhiteSpace(_newName)) return;
        try
        {
            if (_creating == true) Files.CreateFolder(_folder, _newName);
            else Files.CreateFile(_folder, _newName);
            _creating = null;
            _newName = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException) { Toasts.Error(ex); }
    }

    private void StartRename(WebRootEntry entry)
    {
        _renaming = entry.Path;
        _renameTo = entry.Name;
    }

    private Task OnRenameKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _renaming = null;
        return e.Key == "Enter" ? RenameAsync() : Task.CompletedTask;
    }

    private async Task RenameAsync()
    {
        if (_renaming is null || string.IsNullOrWhiteSpace(_renameTo)) return;
        try
        {
            Files.Rename(_renaming, _renameTo);
            _renaming = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException) { Toasts.Error(ex); }
    }

    private async Task DeleteAsync()
    {
        var entry = _deleting;
        _deleting = null;
        if (entry is null) return;
        try
        {
            Files.Delete(entry.Path);
            Toasts.Info("Deleted", entry.Name);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException) { Toasts.Error(ex); }
    }

    // ---- upload ------------------------------------------------------------------------------------

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(200);
        var ok = 0;
        foreach (var file in files)
        {
            _busy = $"Uploading {file.Name}…";
            StateHasChanged();
            try
            {
                await using var stream = file.OpenReadStream(Options.Value.MaxFilesUploadBytes);
                await Files.SaveAsync(_folder, file.Name, stream);
                ok++;
            }
            catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException)
            {
                Toasts.Error(ex, $"Could not upload {file.Name}");
            }
        }
        _busy = null;
        if (ok > 0) Toasts.Success($"Uploaded {ok} file(s)");
        await LoadAsync();
    }

    private async Task UploadZipAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _busy = $"Extracting {file.Name}…";
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(Options.Value.MaxFilesUploadBytes);
            var result = await Files.ExtractZipAsync(_folder, stream);
            Toasts.Success($"Extracted {file.Name}", $"{result.Files} file(s) and {result.Folders} folder(s) added to {(_folder.Length == 0 ? "wwwroot" : _folder)}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException)
        {
            Toasts.Error(ex, $"Could not extract {file.Name}");
        }
        _busy = null;
        await LoadAsync();
    }

    // ---- text editor -------------------------------------------------------------------------------

    private async Task OpenAsync(WebRootEntry entry)
    {
        try
        {
            _text = _saved = await Files.ReadTextAsync(entry.Path);
            _editing = entry.Path;
            _editorWired = false;
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException) { Toasts.Error(ex); }
    }

    private async Task CloseEditorAsync()
    {
        _editing = null;
        _editorWired = false;
        await LoadAsync();
    }

    [JSInvokable]
    public async Task SaveAsync()
    {
        if (_editing is null || _saving) return;
        _saving = true;
        try
        {
            await Files.WriteTextAsync(_editing, _text);
            _saved = _text;
            Toasts.Success("Saved", _editing);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException) { Toasts.Error(ex); }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_editing is null || _editorWired) return;
        _editorWired = true;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DynCMS.UI/dyncms-admin.js");
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("codeEditor.init", _editor, _self);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
