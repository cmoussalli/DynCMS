@page "/admin/system"
@page "/admin/system/{View}"
@namespace DynCMS.UI.Admin.Pages
@attribute [Authorize]
@implements IDisposable
@inject IDatabaseMaintenanceService Maintenance
@inject DatabaseConfigurationStore Store
@inject IPluginManager Plugins

<PageTitle>System · DynCMS</PageTitle>

<div class="dc-section">
    <aside class="dc-tree-panel">
        <div class="dc-panel-head">
            <h2><span class="dc-panel-icon"><Icon Name="info" Size="15" /></span> System</h2>
        </div>
        <div class="dc-tree">
            @if (_isAdmin)
            {
            <div class="dc-tree-group">
                <div class="dc-tree-group-head"><span><Icon Name="layers" Size="14" /> Application</span></div>
                <ul class="dc-tree-list">
                    <li class="dc-tree-item">
                        <div class="dc-tree-row @(Mode == "version" ? "dc-selected" : null)" style="padding-left:10px">
                            <a class="dc-tree-link" href="/admin/system"><Icon Name="info" Size="15" /><span class="dc-tree-name">Version</span></a>
                        </div>
                    </li>
                </ul>
            </div>
            }
            <div class="dc-tree-group">
                <div class="dc-tree-group-head"><span><Icon Name="zap" Size="14" /> Integrations</span></div>
                <ul class="dc-tree-list">
                    <li class="dc-tree-item">
                        <div class="dc-tree-row @(Mode == "api" ? "dc-selected" : null)" style="padding-left:10px">
                            <a class="dc-tree-link" href="/admin/system/api"><Icon Name="lock" Size="15" /><span class="dc-tree-name">API &amp; AI agents</span></a>
                        </div>
                    </li>
                    @if (_isAdmin)
                    {
                        <li class="dc-tree-item">
                            <div class="dc-tree-row @(Mode == "plugins" ? "dc-selected" : null)" style="padding-left:10px">
                                <a class="dc-tree-link" href="/admin/system/plugins"><Icon Name="box" Size="15" /><span class="dc-tree-name">Plugins</span><small>@_pluginsRunning/@_pluginsTotal</small></a>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            @if (_isAdmin)
            {
            <div class="dc-tree-group">
                <div class="dc-tree-group-head"><span><Icon Name="hard-drive" Size="14" /> Primary database</span></div>
                <ul class="dc-tree-list">
                    <li class="dc-tree-item">
                        <div class="dc-tree-row @(Mode == "database" ? "dc-selected" : null)" style="padding-left:10px">
                            <a class="dc-tree-link" href="/admin/system/database"><Icon Name="activity" Size="15" /><span class="dc-tree-name">Overview</span></a>
                        </div>
                    </li>
                    <li class="dc-tree-item">
                        <div class="dc-tree-row @(Mode == "configuration" ? "dc-selected" : null)" style="padding-left:10px">
                            <a class="dc-tree-link" href="/admin/system/configuration"><Icon Name="sliders" Size="15" /><span class="dc-tree-name">Configuration</span></a>
                        </div>
                    </li>
                    <li class="dc-tree-item">
                        <div class="dc-tree-row @(Mode == "backups" ? "dc-selected" : null)" style="padding-left:10px">
                            <a class="dc-tree-link" href="/admin/system/backups"><Icon Name="save" Size="15" /><span class="dc-tree-name">Backups &amp; restore</span>@if (_backupCount is int n) { <small>@n</small> }</a>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="dc-tree-group">
                <div class="dc-tree-group-head"><span><Icon Name="bar-chart" Size="14" /> Analytics database</span></div>
                <ul class="dc-tree-list">
                    <li class="dc-tree-item">
                        <div class="dc-tree-row @(Mode == "analytics" ? "dc-selected" : null)" style="padding-left:10px">
                            <a class="dc-tree-link" href="/admin/system/analytics"><Icon Name="sliders" Size="15" /><span class="dc-tree-name">Configuration</span>@if (!Store.IsAnalyticsSeparate) { <small class="dc-badge dc-badge-muted">shared</small> }</a>
                        </div>
                    </li>
                    <li class="dc-tree-item">
                        <div class="dc-tree-row @(Mode == "analytics-backups" ? "dc-selected" : null)" style="padding-left:10px">
                            <a class="dc-tree-link" href="/admin/system/analytics-backups"><Icon Name="save" Size="15" /><span class="dc-tree-name">Backups &amp; restore</span>@if (_analyticsBackupCount is int a) { <small>@a</small> }</a>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="dc-tree-group">
                <div class="dc-tree-group-head"><span><Icon Name="alert" Size="14" /> Danger zone</span></div>
                <ul class="dc-tree-list">
                    <li class="dc-tree-item">
                        <div class="dc-tree-row @(Mode == "reset" ? "dc-selected" : null)" style="padding-left:10px">
                            <a class="dc-tree-link" href="/admin/system/reset"><Icon Name="rotate-ccw" Size="15" /><span class="dc-tree-name">Reset configuration</span></a>
                        </div>
                    </li>
                </ul>
            </div>
            }
        </div>
    </aside>

    <main class="dc-workspace">
        @switch (Mode)
        {
            case "api":
                <ApiKeysPanel />
                break;
            case "plugins":
                <PluginsPanel />
                break;
            case "database":
                <DataOverview OnChanged="RefreshCountAsync" />
                break;
            case "configuration":
                <DataConfiguration />
                break;
            case "backups":
                <DataBackups OnChanged="RefreshCountAsync" />
                break;
            case "analytics":
                <DataAnalyticsConfiguration OnChanged="RefreshCountAsync" />
                break;
            case "analytics-backups":
                <DataBackups Role="DatabaseRole.Analytics" OnChanged="RefreshCountAsync" />
                break;
            case "reset":
                <DataReset />
                break;
            default:
                <SystemVersion />
                break;
        }
    </main>
</div>

@code {
    [Parameter] public string? View { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isAdmin;
    private int? _backupCount;
    private int? _analyticsBackupCount;
    private int _pluginsRunning;
    private int _pluginsTotal;

    // Editors only get their own API keys here; every other view is for Administrators.
    private string Mode => _isAdmin ? AdminMode : "api";

    private string AdminMode => (View ?? string.Empty).ToLowerInvariant() switch
    {
        "api" => "api",
        "plugins" => "plugins",
        "database" or "data" or "overview" => "database",
        "configuration" or "config" => "configuration",
        "backups" or "backup" => "backups",
        "analytics" => "analytics",
        "analytics-backups" or "analytics-backup" => "analytics-backups",
        "reset" => "reset",
        _ => "version"
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) _isAdmin = (await AuthState).User.IsInRole(CmsRoles.Admin);
        Plugins.Changed += OnPluginsChanged;
        ReadPlugins();
        if (_isAdmin) await RefreshCountAsync();
    }

    private void OnPluginsChanged() => _ = InvokeAsync(() => { ReadPlugins(); StateHasChanged(); });

    private void ReadPlugins()
    {
        _pluginsTotal = Plugins.Plugins.Count;
        _pluginsRunning = Plugins.Plugins.Count(p => p.IsRunning);
    }

    public void Dispose() => Plugins.Changed -= OnPluginsChanged;

    private async Task RefreshCountAsync()
    {
        try
        {
            _backupCount = (await Maintenance.ListBackupsAsync()).Count;
            _analyticsBackupCount = Store.IsAnalyticsSeparate ? (await Maintenance.ListBackupsAsync(DatabaseRole.Analytics)).Count : null;
        }
        catch
        {
            _backupCount = null;
            _analyticsBackupCount = null;
        }
    }
}
