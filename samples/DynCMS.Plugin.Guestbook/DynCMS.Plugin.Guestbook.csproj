<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    A DynCMS plugin is a Razor class library that references only the DynCMS plugin SDK. This sample brings a public
    /guestbook page, a moderated /admin/guestbook section with a top-bar link, a minimal API, an API controller, a
    service with its own SQLite database in the plugin's data folder, options bound from settings, and a stylesheet
    served from wwwroot.

    Build it and upload bin/Debug/DynCMS.Plugin.Guestbook.plugin.zip on Settings → Plugins, or copy the package's
    contents to App_Data/plugins/DynCMS.Plugin.Guestbook/ and click "Rescan folder". For a tight edit-build-test
    loop point the build straight at a site's plugin folder:
      dotnet build -p:DynCmsPluginDeployDir=..\..\src\DynCMS.Web\App_Data\plugins
    and click "Reload" on the Plugins page afterwards.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DynCMS.Plugin.Guestbook</RootNamespace>

    <!-- Shown on the Plugins page (DynCmsPlugin reads the assembly attributes). -->
    <AssemblyTitle>Guestbook</AssemblyTitle>
    <Description>Visitors sign a guestbook on the site; entries are moderated in the back office and stored in the plugin's own SQLite database.</Description>
    <Company>DynCMS samples</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      In a project outside this repository this is
        <PackageReference Include="DynCMS.Plugins.Sdk" Version="..." />
      and the two Import lines below disappear: NuGet imports the package's build/*.props and *.targets by itself.
      Private="false": the site already has the SDK, the plugin must not ship its own copy.
    -->
    <ProjectReference Include="..\..\src\DynCMS.Plugins.Sdk\DynCMS.Plugins.Sdk.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the plugin uses besides the SDK. The site already ships EF Core (same version), so nothing of it is copied into the package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <Import Project="..\..\src\DynCMS.Plugins.Sdk\build\DynCMS.Plugins.Sdk.props" />
  <Import Project="..\..\src\DynCMS.Plugins.Sdk\build\DynCMS.Plugins.Sdk.targets" />

</Project>
