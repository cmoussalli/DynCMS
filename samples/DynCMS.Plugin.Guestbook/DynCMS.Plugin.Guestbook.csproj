<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    A DynCMS plugin is a Razor class library. This sample brings a public /guestbook page, a moderated
    /admin/guestbook section with a top-bar link, a minimal API, an API controller, a service with its own SQLite
    database in the plugin's data folder, options bound from settings, and a stylesheet served from wwwroot.

    Build it and upload bin/Debug/DynCMS.Plugin.Guestbook.plugin.zip on Settings → Plugins, or copy the package's
    contents to App_Data/plugins/DynCMS.Plugin.Guestbook/ and click "Rescan folder". For a tight edit-build-test
    loop point the build straight at a site's plugin folder:
      dotnet build -p:DynCmsPluginDeployDir=..\..\src\DynCMS.Web\App_Data\plugins
    and click "Reload" on the Plugins page afterwards.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DynCMS.Plugin.Guestbook</RootNamespace>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>_content/DynCMS.Plugin.Guestbook</StaticWebAssetBasePath>
    <IsPackable>false</IsPackable>

    <!-- Shown on the Plugins page (DynCmsPlugin reads the assembly attributes). -->
    <AssemblyTitle>Guestbook</AssemblyTitle>
    <Description>Visitors sign a guestbook on the site; entries are moderated in the back office and stored in the plugin's own SQLite database.</Description>
    <Company>DynCMS samples</Company>
    <Version>1.0.0</Version>

    <!-- The host provides DynCMS and everything it depends on; only the plugin's own assemblies go in the package. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- In a project outside this repository these are PackageReferences to DynCMS.Core and DynCMS.UI with the same
         Private="false" / ExcludeAssets="runtime": the site already has them, the plugin must not ship its own copies. -->
    <ProjectReference Include="..\..\src\DynCMS.Core\DynCMS.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\src\DynCMS.UI\DynCMS.UI.csproj" Private="false" />
  </ItemGroup>

  <!--
    Packaging: bin/<Configuration>/<AssemblyName>.plugin.zip with the layout the plugin manager expects
    (bin/ with the assemblies, wwwroot/ with static files). Set DynCmsPluginDeployDir to also copy the layout into a
    site's plugin folder.
  -->
  <Target Name="PackDynCmsPlugin" AfterTargets="Build" Condition="'$(PackDynCmsPlugin)' != 'false'">
    <PropertyGroup>
      <_PluginStage>$(IntermediateOutputPath)dyncms-plugin\</_PluginStage>
      <_PluginPackage>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(AssemblyName).plugin.zip</_PluginPackage>
    </PropertyGroup>
    <ItemGroup>
      <_PluginBinaries Include="$(TargetDir)*.dll;$(TargetDir)*.pdb;$(TargetDir)*.deps.json" />
      <_PluginAssets Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_PluginStage)" />
    <Copy SourceFiles="@(_PluginBinaries)" DestinationFolder="$(_PluginStage)bin" />
    <Copy SourceFiles="@(_PluginAssets)" DestinationFiles="@(_PluginAssets->'$(_PluginStage)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Delete Files="$(_PluginPackage)" />
    <ZipDirectory SourceDirectory="$(_PluginStage)" DestinationFile="$(_PluginPackage)" Overwrite="true" />
    <Message Importance="high" Text="DynCMS plugin package: $(_PluginPackage)" />

    <ItemGroup Condition="'$(DynCmsPluginDeployDir)' != ''">
      <_PluginStaged Include="$(_PluginStage)**\*" />
    </ItemGroup>
    <Copy Condition="'$(DynCmsPluginDeployDir)' != ''" SourceFiles="@(_PluginStaged)" DestinationFiles="@(_PluginStaged->'$(DynCmsPluginDeployDir)\$(AssemblyName)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Condition="'$(DynCmsPluginDeployDir)' != ''" Importance="high" Text="DynCMS plugin deployed to: $(DynCmsPluginDeployDir)\$(AssemblyName) (click Reload on Settings → Plugins)" />
  </Target>

</Project>
